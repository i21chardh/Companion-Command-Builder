+	private relativeCacheScope(config: ModuleConfig = this.config): string {
+		return `${config.selected || ''}|${config.host?.trim() || ''}|${Number(config.port) || 0}`
+	}
+
+	private restoreRelativeStateCache(): void {
+		if (!this.config.relativeStateCache) return
+		try {
+			const parsed = JSON.parse(this.config.relativeStateCache) as { scope?: string; channels?: Record<string, number>; sends?: Record<string, number> }
+			if (parsed.scope !== this.relativeCacheScope()) return
+			for (const [key, gain] of Object.entries(parsed.channels ?? {}).slice(0, 128)) {
+				if (!/^\d+\.\d+$/.test(key) || !Number.isFinite(gain) || gain < -144 || gain > 10) continue
+				const [group, ch] = key.split('.').map(Number)
+				this.ensureChannel(group, ch).gain = gain
+				this.knownOutputGains.add(key)
+			}
+			for (const [key, gain] of Object.entries(parsed.sends ?? {}).slice(0, 512)) {
+				if (!/^\d+\.\d+\.\d+$/.test(key) || !Number.isFinite(gain) || gain < -144 || gain > 10) continue
+				this.sends.set(key, { on: false, gain })
+				this.knownSendGains.add(key)
+			}
+		} catch {
+			this.log('warn', 'Ignored malformed relative-control state cache')
+		}
+	}
+
+	private scheduleRelativeStateCacheSave(): void {
+		if (this.relativeCacheTimer) clearTimeout(this.relativeCacheTimer)
+		this.relativeCacheTimer = setTimeout(() => this.flushRelativeStateCache(), 350)
+	}
+
+	private flushRelativeStateCache(): void {
+		if (this.relativeCacheTimer) clearTimeout(this.relativeCacheTimer)
+		this.relativeCacheTimer = null
+		const channels = Object.fromEntries([...this.channels.entries()].filter(([key, state]) => this.knownOutputGains.has(key) && Number.isFinite(state.gain)).slice(-128).map(([key, state]) => [key, state.gain]))
+		const sends = Object.fromEntries([...this.sends.entries()].filter(([key, state]) => this.knownSendGains.has(key) && Number.isFinite(state.gain)).slice(-512).map(([key, state]) => [key, state.gain]))
+		const relativeStateCache = JSON.stringify({ scope: this.relativeCacheScope(), channels, sends })
+		if (relativeStateCache === this.config.relativeStateCache) return
+		this.config = { ...this.config, relativeStateCache }
+		this.saveConfig(this.config)
+	}
